{
  "manifest_version": 3,
  "name": "AcrossIcon AI",
  "description": "Side Panel AI visual generator — logos, product banners, and hero images.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open AcrossIcon AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "downloads", "unlimitedStorage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://*.blob.core.windows.net/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ]
}
